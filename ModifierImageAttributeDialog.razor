@using IdmToolkit.Domain.ViewModels
<MudDialog Style="max-width: 700px; max-height: 800px;">
    <TitleContent>
        <MudText Typo="Typo.h6">@Attribute!.Type!.Description</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="d-flex align-center flex-column">
            <MudText Typo="Typo.body1">@Attribute!.Value</MudText>
            <MudImage Class="mt-3" Src="@PublixImageUrlBuilder.BuildImageUrl(Attribute!.Value)" />
        </MudPaper>
    </DialogContent>
</MudDialog>
@code {
    [Parameter]
    public ModifierAttributeViewModel? Attribute { get; set; }
}