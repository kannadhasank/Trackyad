@using IdmToolkit.Client.Helpers
 
<MudDialog Style="max-width: 700px; max-height: 800px;">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="d-flex align-center flex-column">
            <MudText Typo="Typo.body1">@ImageUrl</MudText>
            <MudImage Class="mt-3" Src="@PublixImageUrlBuilder.BuildImageUrl(ImageUrl)" />
        </MudPaper>
    </DialogContent>
</MudDialog>
 
@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string ImageUrl { get; set; } = string.Empty;
}
 