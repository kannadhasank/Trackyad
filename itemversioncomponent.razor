@using IdmToolkit.Domain.Interfaces
@using IdmToolkit.Domain.Models
@using IdmToolkit.Domain.Models.ProductOfferingSnapshots
@using IdmToolkit.Domain.ViewModels
@using System.Net
@using System.Text.RegularExpressions
@using MudBlazor
@inherits AppComponentBase
@inject IProductOfferingVersionService VersionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_isLoading)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Style="color: white;">@LoadingMessage</MudText>
        </MudStack>
    </MudOverlay>
}

<ItemWorkflowStepper ItemCode="@ItemCode"
                     ChangeSetId="@ChangeSetId" />

@if (_version != null)
{
    <MudPaper Elevation="0" Class="review-shell pa-6 mb-4">
        <MudStack Spacing="4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="review-header">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.RateReview" Color="Color.Primary" />
                        <MudText Typo="Typo.h4" Style="font-weight: 800;" Color="Color.Primary">@Title</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">@Subtitle</MudText>
                </MudStack>

                @if (ActionButtons != null)
                {
                    @ActionButtons
                }
            </MudStack>

            <MudDivider />

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Item Code</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@ItemCode</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Product Offer ID</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@GetProductOfferIdText()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Applied Platforms</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@GetAppliedPlatformsText()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Family Group</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@GetFamilyGroupText()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Sub Department</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@GetSubDepartmentText()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Applied Stores</MudText>
                        <MudText Typo="Typo.h6" Class="mud-text-primary font-weight-medium">@GetAppliedStoresText()</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="review-summary-card pa-4 rounded-lg">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px;">Current Item Status</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Text="@GetStatusText()" />
                    </MudPaper>
                </MudItem>
            </MudGrid>



            <MudGrid Spacing="3" Class="mt-2">
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="2" Class="review-card product-image-card pa-3 rounded-lg d-flex justify-center align-center" Style="min-height: 240px; height: 100%;">
                        @if (!string.IsNullOrWhiteSpace(GetProductImageUrl()))
                        {
                            <MudImage Src="@GetProductImageUrl()" Alt="Product image" Fluid="true" Style="width: 100%; max-width: 320px; object-fit: contain;" />
                        }
                        else
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Default" />
                                <MudText Typo="Typo.body2" Class="mud-text-primary">Image not available</MudText>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg" Style="height: 100%;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">Product Summary</MudText>
                        </MudStack>
                        <div style="display: grid; grid-template-columns: 210px minmax(0, 1fr); column-gap: 24px; row-gap: 12px; align-items: start;">
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Product Title:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetProductTitleText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Offering Category:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetOfferingCategoryText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Display Type:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetDisplayTypeText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">GTIN/UPC:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@_version?.BaseDetails?.PrimaryGtin</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Unit Of Measure:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetUnitOfMeasureText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Online Pay:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetOnlinePayText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Online Orderable Item:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetOnlineOrderableItemText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2; white-space: nowrap;">Base Product ID:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="line-height: 1.35; overflow-wrap: normal;">@GetBaseProductIdText()</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">Presentation Categories</MudText>
                        </MudStack>
                        <MudPaper Outlined="true" Elevation="0" Class="review-inner-card pa-2 my-3 rounded-lg" Style="max-height: 190px; overflow-y: auto;">
                            @if (_version.PresentationCategories == null || _version.PresentationCategories.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-primary">No presentation categories found</MudText>
                            }
                            else
                            {
                                <MudStack Spacing="1">
                                    @foreach (var category in _version.PresentationCategories)
                                    {
                                        <MudGrid Spacing="1" Class="align-start py-1">
                                            <MudItem xs="2" Class="d-flex justify-center">
                                                <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-medium">@category.SequenceNumber</MudText>
                                            </MudItem>
                                            <MudItem xs="10">
                                                <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium" Style="overflow-wrap: anywhere; line-height: 1.35;">@category.FauxTaxonomy</MudText>
                                            </MudItem>
                                        </MudGrid>
                                    }
                                </MudStack>
                            }
                        </MudPaper>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="3" Class="mt-2">
                <MudItem xs="12" md="5">
                    <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg" Style="height: 100%;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">Item Description Details</MudText>
                        </MudStack>
                        <div class="mt-3" style="display: grid; grid-template-columns: 180px minmax(0, 1fr); column-gap: 16px; row-gap: 10px; align-items: start;">
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Item Description:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetItemDescriptionText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">PIMS Size Description:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetPimsSizeDescriptionText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Item Size:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetItemSizeText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Size/Unit of Measure:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetSizeUnitOfMeasureText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Title Synonyms:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetTitleSynonymsText()</MudText>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Product Avg Weight:</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@GetProductAverageWeightText()</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg" Style="height: 100%;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">Product Description</MudText>
                        </MudStack>
                        <MudPaper Outlined="true" Elevation="0" Class="review-description-card pa-4 my-3 rounded-lg" Style="min-height: 140px; max-height: 220px; overflow-y: auto;">
                            <MudText Typo="Typo.body1" Class="mud-text-primary" Style="white-space: pre-wrap; line-height: 1.5;">@GetFinalProductDescriptionDisplayText()</MudText>
                        </MudPaper>
                        @if (!string.IsNullOrWhiteSpace(_version.SmartLabelUrl))
                        {
                            <MudGrid Spacing="1" Class="align-center">
                                <MudItem xs="4">
                                    <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">Smart Label URL</MudText>
                                </MudItem>
                                <MudItem xs="8">
                                    <MudLink Href="@_version.SmartLabelUrl" Target="_blank" Typo="Typo.body2">@_version.SmartLabelUrl</MudLink>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudExpansionPanels MultiExpansion="true" Class="review-expansion-panels mt-2" Elevation="2">
                <MudExpansionPanel Expanded="false">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Dataset" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 800;">Additional Data</MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg" Style="height: 100%;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Source" Color="Color.Primary" Size="Size.Small" />
                                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">Source Item Information</MudText>
                                    </MudStack>
                                    <MudGrid Spacing="2" Class="mt-2">
                                        @foreach (var field in GetSourceItemInformationRows())
                                        {
                                            <MudItem xs="6"><MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">@field.Label</MudText></MudItem>
                                            <MudItem xs="6"><MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@field.Value</MudText></MudItem>
                                        }
                                        @foreach (var sourceAttribute in GetPopulatedSourceAttributes())
                                        {
                                            <MudItem xs="6"><MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">@GetSourceAttributeLabel(sourceAttribute)</MudText></MudItem>
                                            <MudItem xs="6"><MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@sourceAttribute.Value</MudText></MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudPaper Elevation="2" Class="review-card pa-4 rounded-lg" Style="height: 100%;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Size="Size.Small" />
                                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">IDM Item Attributes</MudText>
                                    </MudStack>
                                    @if (!GetPopulatedIdmAttributes().Any())
                                    {
                                        <MudPaper Class="review-empty-state pa-4 mt-3 text-center" Outlined Elevation="0">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Small" />
                                            <MudText Typo="Typo.body2" Class="mud-text-primary mt-1">No populated IDM item attributes found</MudText>
                                        </MudPaper>
                                    }
                                    else
                                    {
                                        <MudGrid Spacing="2" Class="mt-2">
                                            @foreach (var idmAttribute in GetPopulatedIdmAttributes())
                                            {
                                                <MudItem xs="6"><MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.5px; line-height: 1.2;">@GetIdmAttributeLabel(idmAttribute)</MudText></MudItem>
                                                <MudItem xs="6"><MudText Typo="Typo.body2" Class="mud-text-primary font-weight-medium">@idmAttribute.Value</MudText></MudItem>
                                            }
                                        </MudGrid>
                                    }
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Expanded="false">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 800;">Modifier Mapping</MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if (!GetModifierGroupMappings().Any())
                        {
                            <MudPaper Class="review-empty-state pa-5 text-center" Outlined Elevation="0">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="mud-text-primary mt-1">No modifier mappings found</MudText>
                            </MudPaper>
                        }
                        else
                        {
                            <MudExpansionPanels MultiExpansion="true">
                                @foreach (var modifierGroup in GetModifierGroupMappings())
                                {
                                    <MudExpansionPanel Expanded="false">
                                        <TitleContent>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Modifier Group Name: @GetModifierGroupText(modifierGroup)</MudText>
                                                <MudText Typo="Typo.subtitle2">Display Seq#: @GetNullableNumberText(modifierGroup.DisplaySequence)</MudText>
                                            </MudStack>
                                        </TitleContent>

<ChildContent>
                                            <MudTable Items="@modifierGroup.Modifiers" Dense="true" Hover="true" Elevation="0" Class="mt-2">
                                                <HeaderContent><MudTh>ID</MudTh><MudTh>Description</MudTh><MudTh>Display Sequence</MudTh><MudTh>Defaulted</MudTh><MudTh>Mobile Image</MudTh><MudTh>Web Image</MudTh></HeaderContent>
                                                <RowTemplate>
                                                    <MudTd DataLabel="ID">@context.ModifierId</MudTd>
                                                    <MudTd DataLabel="Description">@context.ModifierName</MudTd>
                                                    <MudTd DataLabel="Display Sequence">@GetNullableNumberText(context.DisplaySequence)</MudTd>
                                                    <MudTd DataLabel="Defaulted">
                                                        @if (context.IsDefaultModifier)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" aria-label="Default modifier" />
                                                        }
                                                    </MudTd>
                                                    <MudTd DataLabel="Mobile Image">
                                                        @if (!string.IsNullOrWhiteSpace(context.ReviewAttributes.MobileImageUrl))
                                                        {
                                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Info" Size="Size.Small" OnClick="@(() => ShowModifierImageDialog(BuildModifierAttribute(context.ReviewAttributes.MobileImageUrl!, ModifierMobileImageTitle)))" aria-label="View mobile modifier image" />
                                                        }
                                                    </MudTd>
                                                    <MudTd DataLabel="Web Image">
                                                        @if (!string.IsNullOrWhiteSpace(context.ReviewAttributes.WebImageUrl))
                                                        {
                                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Info" Size="Size.Small" OnClick="@(() => ShowModifierImageDialog(BuildModifierAttribute(context.ReviewAttributes.WebImageUrl!, ModifierWebImageTitle)))" aria-label="View web modifier image" />
                                                        }
                                                    </MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        }
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Expanded="false">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 800;">Show/Hide Selection</MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        @if (_version.ShowHideRules == null || _version.ShowHideRules.Count == 0)
                        {
                            <MudPaper Class="review-empty-state pa-5 text-center" Outlined Elevation="0"><MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Primary" /><MudText Typo="Typo.body2" Class="mud-text-primary mt-1">No show/hide rules found</MudText></MudPaper>
                        }
                        else
                        {
                            <MudTable Items="@_version.ShowHideRules" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent><MudTh>When Modifier selected</MudTh><MudTh>Action</MudTh><MudTh>Modifier Group</MudTh></HeaderContent>
                                <RowTemplate><MudTd DataLabel="When Modifier selected">@GetShowHideModifierText(context)</MudTd><MudTd DataLabel="Action"><MudChip T="string" Size="Size.Small" Color="@GetShowHideActionColor(context)" Variant="Variant.Text">@GetShowHideActionText(context)</MudChip></MudTd><MudTd DataLabel="Modifier Group">@GetShowHideModifierGroupText(context)</MudTd></RowTemplate>
                            </MudTable>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

        </MudStack>
    </MudPaper>
}

<style>
    .review-shell { border-radius: 16px; background: linear-gradient(180deg, rgba(255,255,255,.98) 0%, rgba(248,252,247,.96) 100%); border: 1px solid rgba(46,125,50,.08); }
    .review-header { padding-bottom: 4px; }
    .review-summary-card, .review-card { position: relative; overflow: hidden; border: 1px solid rgba(46,125,50,.10); background: rgba(255,255,255,.92); transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease; }
    .review-summary-card::before, .review-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--mud-palette-primary); opacity: .7; }
    .review-summary-card:hover, .review-card:hover { transform: translateY(-1px); border-color: rgba(46,125,50,.25); box-shadow: 0 8px 22px rgba(0,0,0,.10); }
    .product-image-card { background: radial-gradient(circle at center, rgba(46,125,50,.05), rgba(255,255,255,.95)); }
    .review-inner-card, .review-description-card, .review-empty-state { background-color: rgba(250,253,249,.95); border-color: rgba(46,125,50,.14); }
    .review-description-card { box-shadow: inset 0 0 0 1px rgba(46,125,50,.04); }
    .review-expansion-panels .mud-expand-panel { border: 1px solid rgba(46,125,50,.10); }
    .review-expansion-panels .mud-expand-panel-header { min-height: 72px; background: rgba(250,253,249,.92); }
</style>

@code {
    [Parameter] public string ItemCode { get; set; } = string.Empty;
    [Parameter] public int? ChangeSetId { get; set; }
    [Parameter] public int? ProductOfferingId { get; set; }
    [Parameter] public string Title { get; set; } = "Version Details";
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string LoadingMessage { get; set; } = "Loading version...";
    [Parameter] public RenderFragment? ActionButtons { get; set; }
    [Parameter] public EventCallback<ProductOfferingVersionDto?> OnVersionLoaded { get; set; }

    private ProductOfferingVersionDto? _version;
    private bool _isLoading;
    private const string ModifierMobileImageTitle = "Modifier Mob Image URL";
    private const string ModifierWebImageTitle = "Modifier Web Image URL";

    protected override async Task OnInitializedAsync()
    {
        await LoadVersionAsync();
    }

    private async Task LoadVersionAsync()
    {
        _isLoading = true;
        try
        {
            _version = await VersionService.GetVersionByIdAsync(ProductOfferingId, ChangeSetId, CancellationToken);
            if (_version == null)
            {
                var versionId = ChangeSetId?.ToString() ?? ProductOfferingId?.ToString() ?? "unknown";
                Snackbar.Add($"Version {versionId} not found", Severity.Error);
                Navigation.NavigateTo($"/items/{ItemCode}");
            }
            else
            {
                await OnVersionLoaded.InvokeAsync(_version);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading version: {ex.Message}", Severity.Error);
            Navigation.NavigateTo($"/items/{ItemCode}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetProductImageUrl()
    {
        return PublixImageUrlBuilder.BuildProductImageUrl(GetProductImageCode());
    }

    private string GetProductImageCode()
    {
        var itemCodeDigits = new string(ItemCode.Where(char.IsDigit).ToArray());
        if (itemCodeDigits.Length > 0)
        {
            return itemCodeDigits.PadLeft(6, '0')[^6..];
        }

        var gtin = _version?.BaseDetails?.PrimaryGtin;
        if (string.IsNullOrWhiteSpace(gtin))
        {
            return string.Empty;
        }

        var gtinDigits = new string(gtin.Where(char.IsDigit).ToArray());
        return gtinDigits.Length == 0 ? string.Empty : gtinDigits.PadLeft(6, '0')[^6..];
    }

    private string GetProductTitleText()
    {
        var title = _version?.BaseDetails?.SourceItemName;
        if (!string.IsNullOrWhiteSpace(title)) return title;
        return _version?.BaseDetails?.SourceItemDescription ?? string.Empty;
    }

    private string GetOfferingCategoryText()
    {
        var code = _version?.OfferingCategoryTypeCode;
        var description = _version?.OfferingCategoryDescription;
        if (string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(description)) return string.Empty;
        if (string.IsNullOrWhiteSpace(description)) return code ?? string.Empty;
        if (string.IsNullOrWhiteSpace(code)) return description;
        return $"{code}-{description}";
    }

    private string GetDisplayTypeText()
    {
        return _version?.DisplayTypeCode ?? string.Empty;
    }

    private string GetUnitOfMeasureText()
    {
        var uom = _version?.BaseDetails?.SourceSellableUom;
        if (string.IsNullOrWhiteSpace(uom))
        {
            uom = _version?.BaseDetails?.SourceSizeUom;
        }
        return uom ?? string.Empty;
    }

    private string GetOnlinePayText()
    {
        return _version?.BaseDetails?.EnableOnlinePay == true ? "Y" : "N";
    }

    private string GetOnlineOrderableItemText()
    {
        return _version?.BaseDetails?.IsOnlineOrderable == true ? "Y" : "N";
    }

    private string GetBaseProductIdText()
    {
        var displayType = GetDisplayTypeText();
        var offerCategory = _version?.OfferingCategoryTypeCode;
        var productOfferId = GetProductOfferIdText();
        if (string.IsNullOrWhiteSpace(displayType) || string.IsNullOrWhiteSpace(offerCategory) || string.IsNullOrWhiteSpace(productOfferId)) return string.Empty;
        return $"{displayType}-{offerCategory}-{productOfferId}";
    }

    private string GetProductOfferIdText()
    {
        return _version?.ProductOfferingId?.ToString() ?? string.Empty;
    }

    private string GetAppliedPlatformsText()
    {
        if (_version?.PlatformVersionIds == null || _version.PlatformVersionIds.Count == 0 || _version.PlatformVersionIds.Contains("ALL"))
        {
            return "All Platforms";
        }

        return string.Join(", ", _version.PlatformVersionIds);
    }

    private string GetFamilyGroupText()
    {
        return string.IsNullOrWhiteSpace(_version?.BaseDetails?.SourceFamilyGroup)
            ? string.Empty
            : _version.BaseDetails.SourceFamilyGroup;
    }

    private string GetSubDepartmentText()
    {
        return string.IsNullOrWhiteSpace(_version?.BaseDetails?.SourceSubDepartment)
            ? string.Empty
            : _version.BaseDetails.SourceSubDepartment;
    }

    private string GetAppliedStoresText()
    {
        if (_version?.StoreNumbers == null || _version.StoreNumbers.Count == 0)
        {
            return "All Stores";
        }

        return string.Join(", ", _version.StoreNumbers);
    }

    private string GetStatusText()
    {
        return _version?.Status ?? string.Empty;
    }

    private string GetItemDescriptionText()
    {
        return _version?.OverviewDescription?.Pims?.ItemDescription ?? _version?.BaseDetails?.SourceItemDescription ?? string.Empty;
    }

    private string GetPimsSizeDescriptionText()
    {
        if (!string.IsNullOrWhiteSpace(_version?.BaseDetails?.SourceSizeDescription))
        {
            return _version.BaseDetails.SourceSizeDescription;
        }

        var firstLine = _version?.OverviewDescription?.Pims?.ScaleDescriptionFirstLine;
        var secondLine = _version?.OverviewDescription?.Pims?.ScaleDescriptionSecondLine;
        var combined = string.Join(" ", new[] { firstLine, secondLine }.Where(value => !string.IsNullOrWhiteSpace(value)));

        return string.IsNullOrWhiteSpace(combined) ? _version?.BaseDetails?.SourceSizeUom ?? string.Empty : combined;
    }

    private string GetItemSizeText()
    {
        return _version?.BaseDetails?.SourceServingSize ?? string.Empty;
    }

    private string GetSizeUnitOfMeasureText()
    {
        return _version?.BaseDetails?.SourceSizeUom ?? string.Empty;
    }

    private string GetTitleSynonymsText()
    {
        return string.Empty;
    }

    private string GetProductAverageWeightText()
    {
        return string.Empty;
    }

    private string GetFinalProductDescriptionText()
    {
        var idmDescription = _version?.OverviewDescription?.Idm?.ItemDescription;
        if (!string.IsNullOrWhiteSpace(idmDescription)) return idmDescription;

        var pimsDescription = _version?.OverviewDescription?.Pims?.ItemDescription;
        if (!string.IsNullOrWhiteSpace(pimsDescription)) return pimsDescription;

        var syndigoDescription = _version?.OverviewDescription?.Syndigo?.ProductDescription;
        return syndigoDescription ?? string.Empty;
    }

    private string GetFinalProductDescriptionDisplayText()
    {
        return ConvertHtmlToDisplayText(GetFinalProductDescriptionText());
    }

    private static string ConvertHtmlToDisplayText(string description)
    {
        var withLineBreaks = Regex.Replace(description, @"</?(p|div|section|h[1-6]|br)[^>]*>", Environment.NewLine, RegexOptions.IgnoreCase);
        var withoutTags = Regex.Replace(withLineBreaks, "<.*?>", string.Empty);
        var decoded = WebUtility.HtmlDecode(withoutTags);
        var normalizedLines = decoded
            .Split(Environment.NewLine, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(line => Regex.Replace(line, @"\s+", " "));

        return string.Join(Environment.NewLine, normalizedLines);
    }

    private IEnumerable<ReviewFieldRow> GetSourceItemInformationRows()
    {
        return
        [
            new("Buyer Group:", _version?.BaseDetails?.SourceBuyerGroup ?? string.Empty),
            new("Scale Lookup Code:", _version?.BaseDetails?.SourceScaleLookupCode ?? string.Empty),
            new("Item Description:", GetItemDescriptionText()),
            new("PIMS Size Description:", GetPimsSizeDescriptionText()),
            new("Item Size:", GetItemSizeText()),
            new("Size/Unit of Measure:", GetSizeUnitOfMeasureText()),
            new("Unit Of Measure:", GetUnitOfMeasureText()),
            new("GTIN/UPC:", _version?.BaseDetails?.PrimaryGtin ?? string.Empty)
        ];
    }

    private IEnumerable<SourceItemAttributeSnapshot> GetPopulatedSourceAttributes()
    {
        return (_version?.AdditionalData?.SourceAttributes ?? [])
            .Where(attribute => !string.IsNullOrWhiteSpace(attribute.Value))
            .Where(attribute => !IsUnpopulatedShowOnCatalogAttribute(attribute))
            .OrderBy(attribute => attribute.GroupCode)
            .ThenBy(attribute => attribute.Code);
    }

    private static bool IsUnpopulatedShowOnCatalogAttribute(SourceItemAttributeSnapshot attribute)
    {
        var label = NormalizeAttributeLabel(attribute.Name ?? attribute.GroupTypeValue ?? attribute.GroupType);
        var value = attribute.Value?.Trim();

        return string.Equals(label, "Show On Catalog", StringComparison.OrdinalIgnoreCase)
            && string.Equals(value, "N/A", StringComparison.OrdinalIgnoreCase);
    }

    private static string? NormalizeAttributeLabel(string? label)
    {
        return label?.Replace("_", " ").Trim().TrimEnd(':').Trim();
    }

    private IEnumerable<IdmItemAttributeSnapshot> GetPopulatedIdmAttributes()
    {
        return (_version?.AdditionalData?.IdmAttributes ?? [])
            .Where(attribute => !string.IsNullOrWhiteSpace(attribute.Value))
            .OrderBy(attribute => attribute.TypeDescription ?? attribute.TypeCode)
            .ThenBy(attribute => attribute.TypeId);
    }

    private static string GetSourceAttributeLabel(SourceItemAttributeSnapshot attribute)
    {
        return $"{attribute.Name ?? attribute.GroupTypeValue ?? attribute.GroupType ?? $"Attribute {attribute.GroupCode}-{attribute.Code}"}:";
    }

    private static string GetIdmAttributeLabel(IdmItemAttributeSnapshot attribute)
    {
        return $"{attribute.TypeDescription ?? attribute.TypeCode ?? $"Attribute {attribute.TypeId}"}:";
    }

    private IEnumerable<ModifierGroupMapping> GetModifierGroupMappings()
    {
        return (_version?.ModifierMapping?.ModifierGroupMappings ?? [])
            .OrderBy(group => group.DisplaySequence)
            .ThenBy(group => group.ModifierGroupId);
    }

