    private static string GetShowHideActionText(ShowHideRuleDto rule)
    {
        return string.Equals(rule.IsModifierGroupExcluded, "Y", StringComparison.OrdinalIgnoreCase) ? "HIDE" : "SHOW";
    }

    private static Color GetShowHideActionColor(ShowHideRuleDto rule)
    {
        return string.Equals(rule.IsModifierGroupExcluded, "Y", StringComparison.OrdinalIgnoreCase) ? Color.Error : Color.Success;
    }

    // NOTE: Assumes ModifierAttributeViewModel exposes a settable `Type` (with a `Description` string)
    // and a settable `Value` (string). Adjust property names/types here if the real view model differs.
    private static ModifierAttributeViewModel BuildModifierAttribute(string value, string description)
    {
        return new ModifierAttributeViewModel
        {
            Value = value,
            Type = new ModifierAttributeTypeViewModel
            {
                Description = description
            }
        };
    }

    private async Task ShowModifierImageDialog(ModifierAttributeViewModel attribute)
    {
        var parameters = new DialogParameters
        {
            ["Attribute"] = attribute
        };
        await DialogService.ShowAsync<ModifierImageAttributeDialog>("Image Attribute", parameters);
    }
    

