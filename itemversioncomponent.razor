        return $"{rule.ModifierId} - {rule.Modifier?.Description ?? rule.Modifier?.DisplayName}";
    }

    private static string GetShowHideModifierGroupText(ShowHideRuleDto rule)
    {
        return $"{rule.ModifierGroupId} - {rule.ModifierGroup?.Description ?? rule.ModifierGroup?.DisplayName}";
